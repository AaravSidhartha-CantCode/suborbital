{
  "buildCommand": "cd agcc/frontend && npm install && npm run build",
  "outputDirectory": "agcc/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "includeFiles": "agcc/{backend/src,data}/**"
    }
  }
}
