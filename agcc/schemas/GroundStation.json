{
  "$defs": {
    "Provenance": {
      "description": "Records origin and currency of externally derived data.",
      "properties": {
        "assumption_fields": {
          "items": {
            "type": "string"
          },
          "title": "Assumption Fields",
          "type": "array"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source_type",
        "source_name",
        "fetched_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "manual",
        "catalog",
        "forecast",
        "measured",
        "derived",
        "not_configured"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "description": "A ground station capable of receiving satellite downlink.",
  "properties": {
    "altitude_m": {
      "description": "Altitude above WGS-84 ellipsoid in meters",
      "minimum": 0.0,
      "title": "Altitude M",
      "type": "number"
    },
    "cost_per_minute_usd": {
      "description": "Cost per contact minute in USD",
      "minimum": 0.0,
      "title": "Cost Per Minute Usd",
      "type": "number"
    },
    "latitude_deg": {
      "description": "Geodetic latitude in degrees",
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Latitude Deg",
      "type": "number"
    },
    "longitude_deg": {
      "description": "Geodetic longitude in degrees",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Longitude Deg",
      "type": "number"
    },
    "max_downlink_rate_mbps": {
      "description": "Station maximum downlink rate in Mbit/s",
      "exclusiveMinimum": 0.0,
      "title": "Max Downlink Rate Mbps",
      "type": "number"
    },
    "min_elevation_deg": {
      "description": "Station minimum elevation mask in degrees",
      "maximum": 90.0,
      "minimum": 0.0,
      "title": "Min Elevation Deg",
      "type": "number"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "station_id": {
      "description": "Unique station ID (prefix: station_)",
      "title": "Station Id",
      "type": "string"
    },
    "supported_bands": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Bands",
      "type": "array"
    }
  },
  "required": [
    "station_id",
    "name",
    "latitude_deg",
    "longitude_deg",
    "altitude_m",
    "supported_bands",
    "min_elevation_deg",
    "max_downlink_rate_mbps",
    "cost_per_minute_usd",
    "provenance"
  ],
  "title": "GroundStation",
  "type": "object"
}
