{
  "$defs": {
    "ScenarioConstraints": {
      "description": "Hard constraints that govern planning for a scenario.",
      "properties": {
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "max_budget_usd": {
          "minimum": 0.0,
          "title": "Max Budget Usd",
          "type": "number"
        }
      },
      "required": [
        "max_budget_usd",
        "deadline"
      ],
      "title": "ScenarioConstraints",
      "type": "object"
    }
  },
  "description": "Root aggregate binding satellite, stations, mission, and constraints.",
  "properties": {
    "constraints": {
      "$ref": "#/$defs/ScenarioConstraints"
    },
    "mission_id": {
      "title": "Mission Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "satellite_id": {
      "title": "Satellite Id",
      "type": "string"
    },
    "scenario_id": {
      "description": "Unique scenario ID (prefix: scenario_)",
      "title": "Scenario Id",
      "type": "string"
    },
    "station_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Station Ids",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "name",
    "satellite_id",
    "station_ids",
    "mission_id",
    "constraints"
  ],
  "title": "Scenario",
  "type": "object"
}
